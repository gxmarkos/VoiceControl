{
  "model_path": "/app/model",
  "chunk": 2048,
  "channels": 1,
  "rate": 16000,
  "input_device_index": 7,
  "commands": [
    {
      "phrases": ["open firefox"],
      "action": "i3-msg 'exec firefox'"
    },
    {
      "phrases": ["open terminal"],
      "action": "i3-msg 'exec i3-sensible-terminal'"
    },
    {
      "phrases": ["close window"],
      "action": "i3-msg '[focus] kill'"
    },
    {
      "phrases": ["test audio"],
      "action": "echo TEST AUDIO"
    },
    {
      "phrases": ["open bicycle", "change to bicycle"],
      "action": "i3-msg '[class=\"(?i)firefox\"] focus' && xdotool sleep 0.2 key ctrl+alt+b sleep 0.2 type 'Bicycle' sleep 0.2 key Return"
    }
  ]
}
